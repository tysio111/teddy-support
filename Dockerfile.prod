# Production image: compiled app plus production dependencies only.
# Secrets are never baked in; they come from .env.prod at runtime.

FROM node:24.14.1-alpine AS build
WORKDIR /app
ENV HUSKY=0
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build && npm prune --omit=dev

FROM node:24.14.1-alpine
WORKDIR /app
ENV NODE_ENV=production \
    NPM_CONFIG_UPDATE_NOTIFIER=false
COPY --from=build --chown=node:node /app/package.json ./
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
# Mail templates are read from src/ at runtime (see src/mail/mail.service.ts)
COPY --from=build --chown=node:node /app/src/mail/mail-templates ./src/mail/mail-templates
# Local uploads directory, only used when FILE_DRIVER=local
RUN mkdir files && chown node:node files
USER node
EXPOSE 3001
CMD ["node", "dist/main"]
