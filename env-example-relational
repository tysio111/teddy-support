NODE_ENV=development
APP_PORT=3001
APP_NAME="NestJS API"
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang
FRONTEND_DOMAIN=http://localhost:3000
BACKEND_DOMAIN=http://localhost:3001
APP_CORS_ORIGINS=http://localhost:3000

DATABASE_TYPE=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=root
DATABASE_PASSWORD=secret
DATABASE_NAME=api
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=
DATABASE_URL=

# Support "local", "s3", "s3-presigned"
FILE_DRIVER=local
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_DEFAULT_S3_BUCKET=

MAIL_HOST=maildev
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_IGNORE_TLS=true
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false
MAIL_DEFAULT_EMAIL=noreply@example.com
MAIL_DEFAULT_NAME=Api
MAIL_CLIENT_PORT=1080

AUTH_JWT_SECRET=secret
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=secret_for_refresh
AUTH_REFRESH_TOKEN_EXPIRES_IN=30d
AUTH_FORGOT_SECRET=secret_for_forgot
AUTH_FORGOT_TOKEN_EXPIRES_IN=30m
AUTH_CONFIRM_EMAIL_SECRET=secret_for_confirm_email
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d
AUTH_UNIFORM_ERRORS=false

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_APP_AUDIENCE=[]

WORKER_HOST=redis://redis:6379/1

# Base URL of the demo shop API used by the action seed (echo service by default)
SEED_SHOP_API_URL=https://httpbin.org/anything/shop

# Intent recognition (LangChain / LangGraph + Anthropic)
INTENT_RECOGNITION_ENABLED=false
ANTHROPIC_API_KEY=
INTENT_LLM_MODEL=claude-haiku-4-5-20251001
INTENT_HISTORY_LIMIT=20
INTENT_MAX_CANDIDATES=3
INTENT_DEFAULT_CONFIDENCE_THRESHOLD=0.7
ACTION_EXECUTION_TIMEOUT_MS=10000
# Leave empty to disable the model fallback chain.
INTENT_LLM_FALLBACK_MODEL=claude-sonnet-5
INTENT_GUARDRAIL_ENABLED=true
INTENT_OUTPUT_GUARDRAIL_ENABLED=true
INTENT_LLM_NODE_TIMEOUT_MS=30000
INTENT_MAX_REPAIR_ATTEMPTS=2
INTENT_MAX_CLARIFICATION_ROUNDS=2
INTENT_MAX_EXECUTION_ATTEMPTS=3
INTENT_EXECUTION_BACKOFF_BASE_MS=500
INTENT_EXECUTION_MAX_BACKOFF_MS=10000
INTENT_CIRCUIT_WINDOW_MS=300000
INTENT_CIRCUIT_FAILURE_RATE=0.5
INTENT_CIRCUIT_MIN_CALLS=5
INTENT_CIRCUIT_COOLDOWN_MS=30000
# postgres | memory (memory loses paused conversations on restart)
INTENT_CHECKPOINTER=postgres
INTENT_PENDING_INPUT_TTL_MS=86400000
# Wait this long after a client message for more before processing the burst (0 disables)
INTENT_DEBOUNCE_MS=1500
INTENT_DEBOUNCE_MAX_WAIT_MS=5000
# Hand a conversation to a human once its estimated LLM spend reaches this many
# USD (unset for no budget)
INTENT_CONVERSATION_BUDGET_USD=1

# Action extraction from client API docs (PDF / DOCX), uses ANTHROPIC_API_KEY
DOC_EXTRACTION_MODEL=claude-sonnet-5-5
DOC_EXTRACTION_MAX_TOKENS=16000

# Knowledge base (RAG over company docs), answers messages that match no
# action. Uses ANTHROPIC_API_KEY; embeddings by Voyage AI, vectors in Qdrant.
KNOWLEDGE_ENABLED=false
VOYAGE_API_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
KNOWLEDGE_COLLECTION=knowledge
# Changing the embedding model or dimension requires re-indexing every resource
KNOWLEDGE_EMBEDDING_MODEL=voyage-3.5
KNOWLEDGE_EMBEDDING_DIMENSION=1024
# Snowball stemmer for keyword search (english, german, french, ...); leave
# empty for no stemming. When set, queries are also rewritten in this language.
KNOWLEDGE_LANGUAGE=
KNOWLEDGE_FAST_MODEL=claude-haiku-4-5
KNOWLEDGE_ANSWER_MODEL=claude-opus-5-5
KNOWLEDGE_ANSWER_EFFORT=medium
KNOWLEDGE_ANSWER_MAX_TOKENS=4000
KNOWLEDGE_CHUNK_TOKENS=500
KNOWLEDGE_CHUNK_OVERLAP_TOKENS=75
KNOWLEDGE_CONTEXTUAL_CHUNKS=true
KNOWLEDGE_PREFETCH_LIMIT=40
KNOWLEDGE_RERANK_CANDIDATES=20
KNOWLEDGE_TOP_K=6
KNOWLEDGE_MIN_RELEVANCE=2
KNOWLEDGE_HYDE_ENABLED=false
KNOWLEDGE_RERANK_ENABLED=true
KNOWLEDGE_HISTORY_LIMIT=6
KNOWLEDGE_OUTPUT_GUARDRAIL_ENABLED=true

# LangSmith tracing (picked up automatically by LangChain)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=teddy-support

# Human hand-off: background summary for the agent inbox, uses ANTHROPIC_API_KEY
HANDOFF_SUMMARY_MODEL=claude-haiku-4-5
HANDOFF_SUMMARY_HISTORY_LIMIT=30

# Rate limiting (in memory, per instance). Each limit counts requests within
# RATE_LIMIT_TTL_MS; 0 disables it. The IP limit applies per route, the
# conversation and client limits to POST /messages.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_IP_LIMIT=300
RATE_LIMIT_CONVERSATION_LIMIT=20
RATE_LIMIT_CLIENT_LIMIT=60

# Privacy: mask card numbers, emails and phones in LLM prompts and logs
PII_REDACTION_ENABLED=true
# Delete conversations inactive for this many days (unset keeps them forever)
# DATA_RETENTION_DAYS=365
DATA_RETENTION_INTERVAL_MINUTES=60
